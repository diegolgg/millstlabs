\usepackage[margin=1in]{geometry}
\usepackage{amsmath,amsthm,amssymb}
\usepackage{xcolor}

% Create shortcuts for new and renew commands
\newcommand{\nc}{\newcommand}
\nc{\rnc}{\renewcommand}

% Initialize theorems and related constructions
\newtheorem{theorem}{Theorem}
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{prop}[theorem]{Proposition}
\newtheorem{ass}[theorem]{Assumption}
\newtheorem{notation}[theorem]{Notation}
\theoremstyle{definition}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{construction}[theorem]{Construction}
\theoremstyle{remark}
\newtheorem{remark}[theorem]{Remark}
\newtheorem*{rem}{Remark}

% Custom
\definecolor{problemblue}{RGB}{0,0,128}
\nc{\hint}{\textcolor{teal}{\textit{Hint:} }}
\renewenvironment{proof}[1][\textcolor{black}{Proof}]{\noindent{#1.} }{\hfill$\square$}
\newtheoremstyle{problemstyle}
  {3pt}% space above
  {3pt}% space below
  {}% body font
  {}% indent amount
  {\color{problemblue}\bfseries}% theorem head font
  {.}% punctuation after theorem head
  { }% space after theorem head
  {\color{problemblue}\bfseries\thmname{#1}\thmnumber{ #2}\normalfont\thmnote{ (#3)}}% theorem head spec
\theoremstyle{problemstyle}
\newtheorem{problem}{Problem}[section]

% Problem counter and custom item
\newcounter{problemcounter}
\setcounter{problemcounter}{0}
\nc{\problemitem}[1]{%
    \stepcounter{problemcounter}%
    \item[\textbf{Problem \theproblemcounter.\arabic{enumi} (#1).}]%
}

